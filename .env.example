# Backend (read by pydantic-settings, prefix HEALTH_)
HEALTH_DATABASE_URL=sqlite:///data/health.db
HEALTH_DATA_DIR=data
HEALTH_API_TOKEN=change-me-to-a-long-random-string
HEALTH_TIMEZONE=America/New_York
HEALTH_COROS_MCP_URL=https://mcp.coros.com/mcp
HEALTH_COROS_OAUTH_CALLBACK_PORT=8765
# Background sync inside the API (0 = off). The cloud deploy sets 15.
HEALTH_SYNC_INTERVAL_MIN=0
# Cloud only: paste the whole data/coros_oauth.json from `health coros auth` (as a secret)
# HEALTH_COROS_TOKEN_JSON=
